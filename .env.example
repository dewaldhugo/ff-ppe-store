APP_NAME="PPE Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ppe-store.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppe_store
DB_USERNAME=ppe
DB_PASSWORD=

# Local (Windows, no Redis): database drivers for queue, cache and session.
# Production: set all three to redis and run Horizon.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Search. SCOUT_QUEUE must be true in production (index updates go through
# the queue) and false locally and in tests.
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
SCOUT_PREFIX=
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Vendor ingestion (VendorSync). Secrets live in .env only.
VENDORSYNC_SJ_BASE_URL=https://ws.safetyjogger.com/v1
VENDORSYNC_SJ_USERNAME=
VENDORSYNC_SJ_PASSWORD=
# Optional: used instead of the password when set.
VENDORSYNC_SJ_TOKEN=
# Footsure CSV exports are delivered here by a process outside this app.
# VENDORSYNC_FS_INCOMING_PATH=
# The schedule only registers when this is true. Keep it false on a developer machine.
VENDORSYNC_SCHEDULE_ENABLED=false
# Queue image jobs after a catalogue run. Use --without-images to skip them for one run.
VENDORSYNC_QUEUE_IMAGES=true
VENDORSYNC_ALERT_EMAIL=
# Local only: db:seed imports tests/Fixtures/VendorSync through the real pipeline.
VENDORSYNC_SEED_FROM_FIXTURES=false

# Store identity (header, footer and trading disclosure). Shown as TBC until set.
STORE_NAME=TBC
STORE_LEGAL_NAME=TBC
STORE_COMPANY_NUMBER=TBC
STORE_REGISTERED_OFFICE=TBC
STORE_VAT_NUMBER=TBC
STORE_PHONE=TBC
STORE_EMAIL=TBC
# Keep the whole site out of search engines. Set to false at launch.
STORE_NOINDEX=true
