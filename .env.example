APP_NAME="Frontline Safety Gear"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ff-ppe-store.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Used by the daily log channel (production: LOG_STACK=daily).
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ff_ppe_store
DB_USERNAME=ppe
DB_PASSWORD=

# Local (Windows, no Redis): database drivers for queue, cache and session.
# Production: set all three to redis and run Horizon.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Local runs over https on Herd; production must be true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Queue names: default (short jobs), images (vendor image jobs) and conversions
# (media conversions). With the database queue, run the worker for all three:
#   php artisan queue:work --queue=default,images,conversions
# `composer dev` already does. Production runs one Horizon supervisor each.
# retry_after must exceed the longest job timeout (see config/queue.php).
# DB_QUEUE_RETRY_AFTER=1200
REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=1200
# Conversions run inside the image job when false; set true to queue them on
# the conversions queue (the conversions supervisor then does the work).
QUEUE_CONVERSIONS_BY_DEFAULT=false

CACHE_STORE=database
# CACHE_PREFIX=

# Redis is only used in production. Locally these are not read.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=ff_ppe_store_
REDIS_DB=0
REDIS_CACHE_DB=1

# Horizon (production only; it cannot run on Windows).
HORIZON_PATH=horizon
HORIZON_DOMAIN=null
HORIZON_PREFIX=ff_ppe_store_horizon:
# Production only (Horizon does not run on Windows): number of image workers.
# HORIZON_IMAGES_PROCESSES=2

# Media. Product images live on the products disk (storage/app/public/products
# unless PRODUCTS_DISK_PATH, relative to storage/, says otherwise).
MEDIA_DISK=public
PRODUCTS_DISK_PATH=app/public/products
# gd (needs WebP support) or imagick.
IMAGE_DRIVER=gd

# app:preflight warns when the storage disk has less free space than this (GB).
PREFLIGHT_MIN_FREE_DISK_GB=10

# Search. SCOUT_QUEUE is false locally, in tests and, for now, in production
# (queued indexing is a later decision, see docs/launch-checklist.md).
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
SCOUT_PREFIX=ff_ppe_store_
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Vendor ingestion (VendorSync). Secrets live in .env only.
VENDORSYNC_SJ_BASE_URL=https://ws.safetyjogger.com/v1
VENDORSYNC_SJ_USERNAME=
VENDORSYNC_SJ_PASSWORD=
# Optional: used instead of the password when set.
VENDORSYNC_SJ_TOKEN=
# Footsure CSV exports are delivered here by a process outside this app.
# VENDORSYNC_FS_INCOMING_PATH=
# VENDORSYNC_FS_ARCHIVE_PATH=
# Listing price = vendor cost x markup. The default is 1.5; a vendor may override it.
# Each must be a number from 1.0 to 5, or the run stops when the mapper is resolved.
VENDORSYNC_MARKUP=1.5
# VENDORSYNC_SJ_MARKUP=
# VENDORSYNC_FS_MARKUP=
# A new vendor cost that differs from the stored cost by more than this percentage is
# held for review (cost, price and compare price kept). 0 switches the guard off.
VENDORSYNC_PRICE_CHANGE_GUARD_PERCENT=40
# Largest vendor image stored and converted. With GD about 8 MB of memory per
# megapixel (a 2560 x 2560 image peaks near 107 MB): raise only together with the
# worker memory or after moving to Imagick.
VENDORSYNC_IMAGE_MAX_MEGAPIXELS=7
# The schedule only registers when this is true. Keep it false on a developer machine.
VENDORSYNC_SCHEDULE_ENABLED=false
# Queue image jobs after a catalogue run. Use --without-images to skip them for one run.
VENDORSYNC_QUEUE_IMAGES=true
VENDORSYNC_ALERT_EMAIL=
# Local only: db:seed imports tests/Fixtures/VendorSync through the real pipeline.
VENDORSYNC_SEED_FROM_FIXTURES=false

# Store identity (header, footer and trading disclosure). Shown as TBC until set.
STORE_NAME=TBC
STORE_LEGAL_NAME=TBC
STORE_COMPANY_NUMBER=TBC
STORE_REGISTERED_OFFICE=TBC
STORE_VAT_NUMBER=TBC
# Where Contact page enquiries go. Leave empty to use the store email in config/store.php.
STORE_ENQUIRY_EMAIL=
# Keep the whole site out of search engines. Set to false at launch.
STORE_NOINDEX=true
# New customers must verify their email address before they can use My Account. With
# MAIL_MAILER=log the verification link is written to storage/logs, so local work is fine.
# app:preflight fails when this is true and MAIL_MAILER is log or array (see docs/accounts.md).
STORE_REQUIRE_EMAIL_VERIFICATION=true

# Card payments (Stripe). Keys come from the Stripe dashboard: test keys (sk_test_, pk_test_) locally,
# live keys in production. Leave empty to keep card payment switched off.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
