# Production template. Copy to .env on the server and fill in the empty values.
# Never commit the real file. Run `php artisan app:preflight` after editing.

APP_NAME="PPE Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redis for queue, cache and session. The prefix and the dedicated database
# numbers keep other sites on the same Redis safe from cache:clear.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=ppe_store_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=ppe_store_
REDIS_DB=10
REDIS_CACHE_DB=11
REDIS_QUEUE=default
# Above the longest job and supervisor timeout (960 s): see config/queue.php.
REDIS_QUEUE_RETRY_AFTER=1200

HORIZON_PATH=horizon
HORIZON_DOMAIN=null
HORIZON_PREFIX=ppe_store_horizon:
# Image workers: each is one concurrent request to the vendor image host and
# about 100 to 200 MB of RAM. Keep it at 2 on the 4 GB server until
# docs/vendorsync.md (Sizing) says otherwise. Run `php artisan horizon:terminate`
# after changing it.
HORIZON_IMAGES_PROCESSES=2

# Media. Conversions stay inline in the image job for now. To move them to the
# conversions queue and its supervisor, set QUEUE_CONVERSIONS_BY_DEFAULT=true
# (see docs/launch-checklist.md).
MEDIA_DISK=public
PRODUCTS_DISK_PATH=app/public/products
IMAGE_DRIVER=gd
QUEUE_CONVERSIONS_BY_DEFAULT=false

# app:preflight warns when the storage disk has less free space than this (GB).
PREFLIGHT_MIN_FREE_DISK_GB=10

# Search. Index updates are sent synchronously for now. Queued indexing
# (SCOUT_QUEUE=true) is to be enabled later, after the first import, as a
# separate decision (docs/launch-checklist.md).
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
SCOUT_PREFIX=
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# No mail is sent until a real mailer is configured.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Vendor ingestion. The schedule stays off until ingestion is switched on.
VENDORSYNC_SJ_BASE_URL=https://ws.safetyjogger.com/v1
VENDORSYNC_SJ_USERNAME=
VENDORSYNC_SJ_PASSWORD=
VENDORSYNC_SJ_TOKEN=
VENDORSYNC_FS_INCOMING_PATH=
VENDORSYNC_FS_ARCHIVE_PATH=
VENDORSYNC_MARKUP=1.5
VENDORSYNC_SJ_MARKUP=
VENDORSYNC_FS_MARKUP=
VENDORSYNC_PRICE_CHANGE_GUARD_PERCENT=40
# Largest vendor image stored and converted. Measured with GD: a 2560 x 2560 image peaks
# at about 107 MB in the image worker, a 7.0 MP worst case at about 147 MB (256M memory_limit).
VENDORSYNC_IMAGE_MAX_MEGAPIXELS=7
VENDORSYNC_SCHEDULE_ENABLED=false
VENDORSYNC_QUEUE_IMAGES=true
VENDORSYNC_ALERT_EMAIL=
VENDORSYNC_SEED_FROM_FIXTURES=false

# Store identity. Replace every TBC before launch.
STORE_NAME=TBC
STORE_LEGAL_NAME=TBC
STORE_COMPANY_NUMBER=TBC
STORE_REGISTERED_OFFICE=TBC
STORE_VAT_NUMBER=TBC
# Lift at launch (see docs/launch-checklist.md).
STORE_NOINDEX=true
# New customers must verify their email address before they can use My Account. This needs a
# real mailer: app:preflight fails while it is true and MAIL_MAILER is log or array. On a server
# with no mailer yet, set STORE_REQUIRE_EMAIL_VERIFICATION=false (docs/accounts.md).
STORE_REQUIRE_EMAIL_VERIFICATION=true
